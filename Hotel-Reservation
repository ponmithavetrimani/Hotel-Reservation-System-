
	package hotel;

	import java.util.ArrayList;
	import java.util.List;
	import java.util.Scanner;

	// ---------------- Room Class ----------------
	class Room {
	    private int roomNumber;
	    private String type;
	    private double price;
	    private boolean isAvailable;

	    public Room(int roomNumber, String type, double price) {
	        this.roomNumber = roomNumber;
	        this.type = type;
	        this.price = price;
	        this.isAvailable = true;
	    }

	    public int getRoomNumber() {
	        return roomNumber;
	    }

	    public String getType() {
	        return type;
	    }

	    public double getPrice() {
	        return price;
	    }

	    public boolean isAvailable() {
	        return isAvailable;
	    }

	    public void setAvailable(boolean available) {
	        this.isAvailable = available;
	    }

	    @Override
	    public String toString() {
	        return "Room " + roomNumber + " [" + type + "] Price: " + price + " Available: " + isAvailable;
	    }
	}

	// ---------------- Customer Class ----------------
	class Customer {
	    protected int customerID;
	    protected String name;
	    protected String contact;

	    public Customer(int customerID, String name, String contact) {
	        this.customerID = customerID;
	        this.name = name;
	        this.contact = contact;
	    }

	    public int getCustomerID() {
	        return customerID;
	    }

	    @Override
	    public String toString() {
	        return "Customer ID: " + customerID + ", Name: " + name + ", Contact: " + contact;
	    }
	}

	// ---------------- PremiumCustomer Class ----------------
	class PremiumCustomer extends Customer {
	    private int loyaltyPoints;
	    private double discount; // percentage

	    public PremiumCustomer(int customerID, String name, String contact, int loyaltyPoints, double discount) {
	        super(customerID, name, contact);
	        this.loyaltyPoints = loyaltyPoints;
	        this.discount = discount;
	    }

	    public double applyDiscount(double amount) {
	        return amount - (amount * discount / 100);
	    }

	    @Override
	    public String toString() {
	        return super.toString() + ", Loyalty Points: " + loyaltyPoints + ", Discount: " + discount + "%";
	    }
	}

	// ---------------- Payment Class ----------------
	class Payment {
	    private double amount;
	    private String method;

	    public Payment(double amount, String method) {
	        this.amount = amount;
	        this.method = method;
	    }

	    public void processPayment() {
	        System.out.println("Payment of " + amount + " by " + method + " processed.");
	    }
	}

	// ---------------- Bill Class ----------------
	class Bill {
	    private double totalAmount;
	    private double taxes = 0.12; // 12% tax
	    private double discount;

	    public Bill(double amount) {
	        this.totalAmount = amount + (amount * taxes);
	        this.discount = 0;
	    }

	    public void applyDiscount(double discount) {
	        this.discount = discount;
	        totalAmount -= discount;
	    }

	    public void printBill() {
	        System.out.println("Bill Total: " + totalAmount + " (Discount Applied: " + discount + ")");
	    }
	}

	// ---------------- Booking Class ----------------
	class Booking {
	    private static int bookingCounter = 1;
	    private int bookingID;
	    private Room room;
	    private Customer customer;
	    private Bill bill;

	    public Booking(Room room, Customer customer) {
	        this.bookingID = bookingCounter++;
	        this.room = room;
	        this.customer = customer;
	        this.room.setAvailable(false);
	        this.bill = new Bill(room.getPrice());
	    }

	    public int getBookingID() {
	        return bookingID;
	    }

	    public void cancelBooking() {
	        room.setAvailable(true);
	        System.out.println("Booking ID " + bookingID + " cancelled.");
	    }

	    public void confirmBooking() {
	        System.out.println("Booking Confirmed! Details:");
	        System.out.println(this);
	        bill.printBill();
	    }

	    public void applyDiscount(double discount) {
	        bill.applyDiscount(discount);
	    }

	    @Override
	    public String toString() {
	        return "Booking ID: " + bookingID + ", " + customer + ", " + room;
	    }
	}

	// ---------------- Hotel Class ----------------
	class Hotel {
	    private String name;
	    private String address;
	    private List<Room> rooms = new ArrayList<>();
	    private List<Customer> customers = new ArrayList<>();
	    private List<Booking> bookings = new ArrayList<>();

	    public Hotel(String name, String address) {
	        this.name = name;
	        this.address = address;
	    }

	    public void addRoom(Room room) {
	        rooms.add(room);
	        System.out.println("Room added: " + room);
	    }

	    public void addCustomer(Customer customer) {
	        customers.add(customer);
	        System.out.println("Customer added: " + customer);
	    }

	    public Room findAvailableRoom(int roomNumber) {
	        for (Room r : rooms) {
	            if (r.getRoomNumber() == roomNumber && r.isAvailable()) {
	                return r;
	            }
	        }
	        return null;
	    }

	    public Customer findCustomer(int customerID) {
	        for (Customer c : customers) {
	            if (c.getCustomerID() == customerID) return c;
	        }
	        return null;
	    }

	    public void makeReservation(int roomNumber, int customerID) {
	        Room room = findAvailableRoom(roomNumber);
	        Customer customer = findCustomer(customerID);
	        if (room != null && customer != null) {
	            Booking booking = new Booking(room, customer);

	            // Apply discount if premium customer
	            if (customer instanceof PremiumCustomer pc) {
	                double discountedPrice = pc.applyDiscount(room.getPrice());
	                double discountAmount = room.getPrice() - discountedPrice;
	                booking.applyDiscount(discountAmount);
	            }

	            bookings.add(booking);
	            booking.confirmBooking();
	        } else {
	            System.out.println("Room not available or customer not found!");
	        }
	    }

	    public void cancelReservation(int bookingID) {
	        Booking bookingToCancel = null;
	        for (Booking b : bookings) {
	            if (b.getBookingID() == bookingID) {
	                bookingToCancel = b;
	                break;
	            }
	        }
	        if (bookingToCancel != null) {
	            bookingToCancel.cancelBooking();
	            bookings.remove(bookingToCancel);
	        } else {
	            System.out.println("Booking ID not found!");
	        }
	    }

	    public void displayRooms() {
	        System.out.println("\nAvailable Rooms:");
	        for (Room r : rooms) {
	            System.out.println(r);
	        }
	    }
	}

	// ---------------- Main Class ----------------
	public class HotelReservationSystem {
	    public static void main(String[] args) {
	        Hotel hotel = new Hotel("Sunrise Hotel", "123 Main St");
	        Scanner sc = new Scanner(System.in);
	        int choice;

	        do {
	            System.out.println("\n------ Hotel Reservation System ------");
	            System.out.println("1. Add Room");
	            System.out.println("2. Add Customer");
	            System.out.println("3. Make Reservation");
	            System.out.println("4. Cancel Reservation");
	            System.out.println("5. Display Rooms");
	            System.out.println("6. Exit");
	            System.out.print("Enter your choice: ");
	            choice = sc.nextInt();
	            sc.nextLine(); // Consume newline

	            switch (choice) {
	                case 1 -> {
	                    System.out.print("Enter Room Number: ");
	                    int rNo = sc.nextInt();
	                    sc.nextLine();
	                    System.out.print("Enter Room Type: ");
	                    String type = sc.nextLine();
	                    System.out.print("Enter Room Price: ");
	                    double price = sc.nextDouble();
	                    sc.nextLine();
	                    hotel.addRoom(new Room(rNo, type, price));
	                }
	                case 2 -> {
	                    System.out.print("Enter Customer ID: ");
	                    int cID = sc.nextInt();
	                    sc.nextLine();
	                    System.out.print("Enter Customer Name: ");
	                    String name = sc.nextLine();
	                    System.out.print("Enter Contact: ");
	                    String contact = sc.nextLine();
	                    System.out.print("Is Premium Customer? (yes/no): ");
	                    String isPremium = sc.nextLine();
	                    if (isPremium.equalsIgnoreCase("yes")) {
	                        System.out.print("Enter Loyalty Points: ");
	                        int points = sc.nextInt();
	                        System.out.print("Enter Discount %: ");
	                        double discount = sc.nextDouble();
	                        sc.nextLine();
	                        hotel.addCustomer(new PremiumCustomer(cID, name, contact, points, discount));
	                    } else {
	                        hotel.addCustomer(new Customer(cID, name, contact));
	                    }
	                }
	                case 3 -> {
	                    System.out.print("Enter Room Number: ");
	                    int roomNumber = sc.nextInt();
	                    System.out.print("Enter Customer ID: ");
	                    int customerID = sc.nextInt();
	                    sc.nextLine();
	                    hotel.makeReservation(roomNumber, customerID);
	                }
	                case 4 -> {
	                    System.out.print("Enter Booking ID to cancel: ");
	                    int bookingID = sc.nextInt();
	                    sc.nextLine();
	                    hotel.cancelReservation(bookingID);
	                }
	                case 5 -> hotel.displayRooms();
	                case 6 -> System.out.println("Exiting system...");
	                default -> System.out.println("Invalid choice! Try again.");
	            }
	        } while (choice != 6);

	        sc.close();
	    }
	}

